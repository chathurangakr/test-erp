# =====================================================================================
#  Coconut Factory ERP — unattended installer settings
# =====================================================================================
#
#  1. Copy this file:            cp deploy/provision.env.example deploy/provision.env
#  2. Fill in the values below   (blank passwords are generated for you)
#  3. Run:                       bash deploy/provision.sh
#
#  The installer locks this file to owner-only (chmod 600) because it can hold passwords.
#  `deploy/provision.env` is ignored by git — it is never committed.
#
#  Every password left BLANK is generated once (long random letters and digits) and kept in
#  /etc/coconut-erp/secrets.env (root-only), so running the installer again reuses it.
#  All credentials are listed there at the end.
#
#  Re-running is safe: it updates the code, installs what changed, runs new migrations and
#  restarts the services. It never deletes data. For updates, run `bash deploy/update.sh`,
#  which backs up the database first and then runs the installer.
#
#  A value containing spaces or any of  $ ` " \ ! #  must be wrapped in single quotes,
#  e.g.  SUDO_PASSWORD='my$ecret pass'
# =====================================================================================

# ---- This computer's administrator (sudo) password ---------------------------------------
# Needed when you run the installer as a normal user. Leave blank if you run it with
# `sudo bash deploy/provision.sh` instead (then nothing is stored). deploy/coconut-erp.sh saves
# it here so later updates never ask; delete it if you prefer to type it each time.
SUDO_PASSWORD=

# ---- Where the code comes from ---------------------------------------------------------
# Either a git repository...
REPO_URL=https://github.com/chathurangakr/test-erp.git
REPO_BRANCH=main
# ...with, for a PRIVATE repository, a GitHub access token (read-only "Contents" permission):
GIT_TOKEN=
# ...or install from a folder already on this computer (e.g. a copy on a USB drive).
# When set, REPO_URL is ignored.
SOURCE_DIR=

# ---- Where it is installed and who runs it ---------------------------------------------
APP_DIR=/var/www/coconut-erp
# A dedicated system account runs the ERP (created if missing; it cannot log in).
APP_USER=coconuterp

# ---- How people reach it ----------------------------------------------------------------
# The address people type in the browser: an IP address or, later, a domain name such as
# erp.yourcompany.lk. Blank = worked out for you: this computer's address on the factory
# network, or, on a cloud server (Oracle, AWS, Google…), its public internet address.
SERVER_NAME=
HTTP_PORT=80
HTTPS_PORT=443
# Your own certificate (both paths) — or leave blank for a self-signed one. Browsers show a
# one-time warning with a self-signed certificate; accept it once on each device.
TLS_CERT_FILE=
TLS_KEY_FILE=
# Turn on the Ubuntu firewall (SSH, HTTP and HTTPS stay open; the database is never exposed).
# On an Oracle Cloud server Oracle's own firewall is used instead, and the web ports are opened
# in it; you must also allow them in the Oracle console (see docs/CLOUD_SERVER.md).
ENABLE_FIREWALL=yes

# ---- Database (MariaDB) -----------------------------------------------------------------
# The MariaDB "root" password. Ubuntu's own root account can still use `sudo mariadb`.
MARIADB_ROOT_PASSWORD=
DB_NAME=coconut_erp
DB_USER=coconut_erp
DB_PASSWORD=

# ---- The first administrator (signs in to the ERP) ---------------------------------------
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
# At least 12 characters with upper and lower case letters, a number and a symbol — and not a
# well-known leaked password. Blank = generated and shown at the end.
ADMIN_PASSWORD=

# ---- Business settings --------------------------------------------------------------------
APP_NAME="Coconut ERP"
# The computer's clock zone (backup times follow it). The ERP itself always uses Sri Lanka
# time for business dates.
TIMEZONE=Asia/Colombo

# ---- Nightly backups ------------------------------------------------------------------------
BACKUP_DIR=/var/backups/coconut-erp
BACKUP_TIME=02:30
BACKUP_KEEP_DAYS=30
